# Dự phòng (Web Admin ưu tiên APP_URL trong public/index.html trên GitHub). URL Web App của Apps Script (Deploy > Manage deployments > Web app URL, dạng https://script.google.com/macros/s/.../exec)
GAS_WEB_APP_URL=
# Địa chỉ công khai của Web Admin (local: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -base64 32
NEXTAUTH_SECRET=
# (Tuỳ chọn) Địa chỉ gốc của FBO cho extension, cách nhau bằng dấu phẩy. Ví dụ: https://erp.congty.vn,http://localhost
EXTENSION_FBO_ORIGINS=
