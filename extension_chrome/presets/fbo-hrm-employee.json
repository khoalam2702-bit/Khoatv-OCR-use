    "quoc_tich": { "selector": "[id$=\"_dirExtender_form_quoc_tich\"]", "map": { "Việt Nam": "VN" } },
    "que_quan": "[id$=\"_dirExtender_form_que_quan\"]",
    "noi_thuong_tru": "[id$=\"_dirExtender_form_dia_chi_th_tru\"]",
    "ngay_cap": { "selector": "[id$=\"_dirExtender_form_cmnd_ngay_hl\"]", "format": "date" },
    "ngay_het_han": { "selector": "[id$=\"_dirExtender_form_cmnd_ngay_hh\"]", "format": "date" }
  }
}
