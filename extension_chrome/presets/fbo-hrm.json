{
  "CCCD": {
    "so_cccd": "[id$=\"_dirExtender_form_cmnd_so\"]",
    "ho_ten": [
      {
        "selector": "[id$=\"_dirExtender_form_ho_nv\"]",
        "transform": "name_head"
      },
      {
        "selector": "[id$=\"_dirExtender_form_ten_nv\"]",
        "transform": "name_last"
      }
    ],
    "ngay_sinh": {
      "selector": "[id$=\"_dirExtender_form_ngay_sinh\"]",
      "format": "date"
    },
    "gioi_tinh": {
      "selector": "[id$=\"_dirExtender_form_gioi_tinh\"]",
      "map": {
        "Nam": "1",
        "Nữ": "2"
      }
    },
    "quoc_tich": {
      "selector": "[id$=\"_dirExtender_form_quoc_tich\"]",
      "map": {
        "Việt Nam": "VN"
      }
    },
    "que_quan": "[id$=\"_dirExtender_form_que_quan\"]",
    "noi_thuong_tru": "[id$=\"_dirExtender_form_dia_chi_th_tru\"]",
    "ngay_cap": {
      "selector": "[id$=\"_dirExtender_form_cmnd_ngay_hl\"]",
      "format": "date"
    },
    "ngay_het_han": {
      "selector": "[id$=\"_dirExtender_form_cmnd_ngay_hh\"]",
      "format": "date"
    }
  },
  "CV_UNGVIEN": {
    "ho_ten": [
      {
        "selector": "[id$=\"_dirExtender_form_ho_uv\"]",
        "transform": "name_head"
      },
      {
        "selector": "[id$=\"_dirExtender_form_ten_uv\"]",
        "transform": "name_last"
      }
    ],
    "email": "[id$=\"_dirExtender_form_email\"]",
    "so_dien_thoai": "[id$=\"_dirExtender_form_dien_thoai\"]",
    "hoc_van": "[id$=\"_dirExtender_form_ghi_chu_dt\"]",
    "vi_tri_ung_tuyen": {
      "selector": "[id$=\"_dirExtender_form_ghi_chu\"]",
      "prefix": "Vị trí: ",
      "append": true
    },
    "so_nam_kinh_nghiem": {
      "selector": "[id$=\"_dirExtender_form_ghi_chu\"]",
      "prefix": "Kinh nghiệm (năm): ",
      "append": true
    },
    "kinh_nghiem_gan_nhat": {
      "selector": "[id$=\"_dirExtender_form_ghi_chu\"]",
      "prefix": "Gần nhất: ",
      "append": true
    },
    "ky_nang": {
      "selector": "[id$=\"_dirExtender_form_ghi_chu\"]",
      "prefix": "Kỹ năng: ",
      "append": true
    }
  }
}